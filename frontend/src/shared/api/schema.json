                "schema": {
                  "$ref": "#/components/schemas/ConstructorStatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/circuit/{circuit_id}": {
      "get": {
        "summary": "Get Circuit Details",
        "description": "Detailed circuit info plus historical data for the given season.\nseason=2026 fetches 2025 results (season-1); returns available_years.",
        "operationId": "get_circuit_details_api_circuit__circuit_id__get",
        "parameters": [
          {
            "name": "circuit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Circuit Id"
            }
          },
          {
            "name": "season",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 2026,
              "title": "Season"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CircuitDetailsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/race-weekend/{circuit_id}": {
      "get": {
        "summary": "Get Race Weekend",
        "description": "Results for one session of a race weekend: race | quali | sprint | fp1 | fp2 | fp3.\nFP sessions are only available for year >= 2023 via OpenF1.",
        "operationId": "get_race_weekend_api_race_weekend__circuit_id__get",
        "parameters": [
          {
            "name": "circuit_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Circuit Id"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 2025,
              "title": "Year"
            }
          },
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "race",
              "title": "Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RaceWeekendResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
