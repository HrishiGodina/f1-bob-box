{
  "openapi": "3.1.0",
  "info": {
    "title": "F1 Dashboard API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/f1auth/status": {
      "get": {
        "summary": "F1Auth Status",
        "operationId": "f1auth_status_api_f1auth_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/F1AuthStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/f1auth/refresh/start": {
      "post": {
        "summary": "F1Auth Refresh Start",
        "operationId": "f1auth_refresh_start_api_f1auth_refresh_start_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshStartResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Get Status",
        "operationId": "get_status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/idle-data": {
      "get": {
        "summary": "Get Idle Data",
        "description": "Fetches standings and news for the idle dashboard.",
        "operationId": "get_idle_data_api_idle_data_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdleDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/milestones": {
      "get": {
        "summary": "Get Milestones",
        "description": "Stats to be beaten for the upcoming race. Simplified prototype.",
        "operationId": "get_milestones_api_milestones_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/MilestonesResponse"
                    },
                    {
                      "$ref": "#/components/schemas/MilestoneErrorResponse"
                    }
                  ],
                  "title": "Response Get Milestones Api Milestones Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/driver/{driver_id}/stats": {
      "get": {
        "summary": "Get Driver Stats",
        "description": "Fetches career statistics for a specific driver.",
        "operationId": "get_driver_stats_api_driver__driver_id__stats_get",
        "parameters": [
          {
            "name": "driver_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Driver Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverStatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/constructor/{constructor_id}/stats": {
      "get": {
        "summary": "Get Constructor Stats",
        "description": "Fetches career statistics for a specific constructor.",
        "operationId": "get_constructor_stats_api_constructor__constructor_id__stats_get",
        "parameters": [
          {
            "name": "constructor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Constructor Id"
            }
